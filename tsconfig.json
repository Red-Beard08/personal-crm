{
  "compilerOptions": {
    "baseUrl": ".", "paths": {"src/*": ["src/*"]},
    "typeRoots": ["node_modules/@types", "node_modules/obsidian"],
    "module": "ESNext", "target": "ES6", "noImplicitAny": true,
    "strictFunctionTypes": true, "strictNullChecks": true, "noImplicitReturns": true,
    "noImplicitThis": true, "noUnusedLocals": true, "moduleResolution": "node",
    "downlevelIteration": true, "esModuleInterop": true, "skipLibCheck": true,
    "lib": ["DOM", "ES6"]
  },
  "include": ["src/**/*.ts"]
}
